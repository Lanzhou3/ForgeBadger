{
  "name": "forgebadger-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:npm": "node scripts/build-npm-package.mjs",
    "dev": "pnpm -r --parallel dev",
    "evidence:feishu-bot-live-audit": "node scripts/audit-feishu-bot-live-report.mjs",
    "evidence:feishu-bot-live-report": "node scripts/create-feishu-bot-live-evidence-report.mjs",
    "evidence:gates-validate": "node scripts/validate-external-evidence-gates.mjs",
    "forgebadger": "pnpm --filter @forgebadger/gateway forgebadger",
    "pack:npm": "pnpm --filter forgebadger pack --dry-run",
    "postinstall": "node scripts/fix-node-pty-helper.mjs",
    "smoke:feishu-bot-live": "node scripts/smoke-feishu-bot-live.mjs",
    "smoke:feishu-bot-websocket": "node scripts/smoke-feishu-bot-websocket.mjs",
    "smoke:feishu-public-webhook": "pnpm --dir packages/gateway exec tsx ../../scripts/prepare-feishu-public-webhook.ts",
    "smoke:npm": "node scripts/smoke-npm-package.mjs",
    "test": "pnpm -r test",
    "trial:feedback-audit": "node scripts/audit-trial-feedback-packet.mjs",
    "trial:feedback-draft": "node scripts/create-trial-feedback-draft.mjs",
    "trial:feedback-issue-audit": "node scripts/audit-trial-feedback-issue.mjs",
    "trial:feedback-issues-audit": "node scripts/audit-trial-feedback-issues.mjs",
    "trial:intake-validate": "node scripts/validate-trial-feedback-intake.mjs",
    "trial:issue-routes-validate": "node scripts/validate-trial-issue-routes.mjs",
    "trial:readiness-validate": "node scripts/validate-trial-readiness.mjs",
    "typecheck": "pnpm -r typecheck",
    "validate:brand": "node scripts/validate-forgebadger-brand.mjs",
    "validate:db-migrations": "node scripts/validate-db-migrations.mjs",
    "verify:npm": "node scripts/verify-npm-package.mjs"
  },
  "engines": {
    "node": ">=20.12 <25",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1"
  }
}
