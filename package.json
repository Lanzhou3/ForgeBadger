{
  "name": "openforge-monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:npm": "node scripts/build-npm-package.mjs",
    "dev": "pnpm -r --parallel dev",
    "openforge": "pnpm --filter @openforge/gateway openforge",
    "pack:npm": "pnpm --filter openforge pack --dry-run",
    "smoke:codex-app-server": "node scripts/smoke-codex-app-server.mjs",
    "smoke:npm": "node scripts/smoke-npm-package.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify:npm": "node scripts/verify-npm-package.mjs"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
