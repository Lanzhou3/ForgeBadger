{
  "name": "@openforge/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/src/db && cp -R src/db/migrations dist/src/db/",
    "dev": "node ../../scripts/run-with-root-env.mjs tsx watch src/index.ts",
    "openforge": "tsx src/cli/init.ts",
    "start": "node ../../scripts/run-with-root-env.mjs node dist/src/index.js",
    "test": "node --test --import tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
