{
  "name": "@openforge/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-with-root-env.mjs next build",
    "dev": "node ../../scripts/run-with-root-env.mjs --shell 'next dev -H ${OPENFORGE_WEB_HOST:-127.0.0.1} -p ${OPENFORGE_WEB_PORT:-48732}'",
    "start": "node ../../scripts/run-with-root-env.mjs --shell 'next start -H ${OPENFORGE_WEB_HOST:-127.0.0.1} -p ${OPENFORGE_WEB_PORT:-48732}'",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-query": "^5.100.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.12",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.74.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
